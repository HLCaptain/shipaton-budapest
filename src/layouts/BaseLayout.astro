---
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const eventsCurrent = Astro.url.pathname.startsWith("/events");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4efe5" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand/shippy-pixel-head.png" type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Shipaton Budapest home">
        <img
          src="/brand/shipaton-wordmark.svg"
          width="535"
          height="128"
          alt="Shipaton 2026"
          decoding="async"
        />
        <span>Budapest</span>
      </a>
      <nav class="site-header__nav" aria-label="Primary navigation">
        <a href="/events/" aria-current={eventsCurrent ? "page" : undefined}>Events</a>
        <a href="https://www.shipaton.com/" rel="noreferrer">Official Shipaton <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div>
        <p>Shipaton Budapest · community-led · 2026</p>
        <p>
          <a href="/brand/shipaton-wordmark.svg">Shipaton wordmark</a>,
          <a href="/brand/rocket-launch-wide.svg">Shippy rocket artwork</a>, and
          <a href="/brand/shippy-pixel-head.png">Shippy icon</a> from RevenueCat’s official media kit.
        </p>
      </div>
      <nav aria-label="Credits and contact">
        <a href="https://www.shipaton.com/media-kit" rel="noreferrer">Media kit <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/HLCaptain" rel="noreferrer">Organizer on GitHub <span aria-hidden="true">↗</span></a>
        <a href="https://x.com/hlcaptain" rel="noreferrer">@hlcaptain on X <span aria-hidden="true">↗</span></a>
      </nav>
    </footer>
  </body>
</html>
