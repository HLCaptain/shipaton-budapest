---
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const eventsCurrent = Astro.url.pathname.startsWith("/events");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4efe5" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand/shippy-pixel-head.png" type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Shipaton Budapest home">
        <img
          src="/brand/shipaton-wordmark.svg"
          width="535"
          height="128"
          alt="Shipaton 2026"
          decoding="async"
        />
        <span>Budapest</span>
      </a>
      <nav class="site-header__nav" aria-label="Primary navigation">
        <a href="/events/" aria-current={eventsCurrent ? "page" : undefined}>Events</a>
        <a href="https://www.shipaton.com/" rel="noreferrer">Official Shipaton <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="site-footer__grid">
        <section class="site-footer__brand" aria-labelledby="footer-brand-title">
          <p class="site-footer__kicker">Shipaton Budapest · 2026</p>
          <h2 id="footer-brand-title">Build locally.<br />Ship globally.</h2>
          <p>Four community-led stops for turning a small idea into an app people can actually use.</p>
        </section>

        <nav aria-labelledby="footer-explore-title">
          <h2 id="footer-explore-title">Explore</h2>
          <a href="/">Home</a>
          <a href="/events/">All events</a>
          <a href="/events/budapest-kickoff/">Budapest kickoff</a>
        </nav>

        <nav aria-labelledby="footer-shipaton-title">
          <h2 id="footer-shipaton-title">Shipaton</h2>
          <a href="https://www.shipaton.com/" rel="noreferrer">Official site <span aria-hidden="true">↗</span></a>
          <a href="https://www.shipaton.com/events" rel="noreferrer">IRL events <span aria-hidden="true">↗</span></a>
          <a href="https://revenuecat-shipaton-2026.devpost.com/" rel="noreferrer">Join on Devpost <span aria-hidden="true">↗</span></a>
          <a href="https://www.shipaton.com/media-kit" rel="noreferrer">Media kit <span aria-hidden="true">↗</span></a>
        </nav>

        <nav aria-labelledby="footer-organizer-title">
          <h2 id="footer-organizer-title">Organizer</h2>
          <a href="https://github.com/HLCaptain" rel="noreferrer">Organizer on GitHub <span aria-hidden="true">↗</span></a>
          <a href="https://x.com/hlcaptain" rel="noreferrer">@hlcaptain on X <span aria-hidden="true">↗</span></a>
        </nav>
      </div>

      <div class="site-footer__bottom">
        <p>Community-led in Budapest · August—September 2026</p>
        <p>
          Official media-kit assets:{" "}
          <a href="/brand/shipaton-wordmark.svg">wordmark</a>,{" "}
          <a href="/brand/rocket-launch-wide.svg">rocket artwork</a>, and{" "}
          <a href="/brand/shippy-pixel-head.png">Shippy icon</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
