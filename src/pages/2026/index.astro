---
import { getCollection } from "astro:content";
import ButtonLink from "../../editions/2026/components/ButtonLink.astro";
import PersonList from "../../editions/2026/components/PersonList.astro";
import {
  eventPath,
  formatEventDateLabel,
  formatEventStatus
} from "../../editions/2026/events";
import BaseLayout from "../../editions/2026/layouts/BaseLayout.astro";

const events = (await getCollection("events2026")).sort((a, b) => a.data.date.localeCompare(b.data.date));
const today = new Intl.DateTimeFormat("en-CA", { timeZone: "Europe/Budapest" }).format(new Date());
const featuredEvent = events.find(({ data }) => data.status === "scheduled" && data.date >= today)
  ?? events.find(({ data }) => data.status === "postponed")
  ?? events.at(-1)!;
const featuredEventUrl = eventPath(featuredEvent.id);
const competitionDeadline = "2026-10-01T06:45:00Z";

const pageTitle = "Shipaton Budapest 2026";
const description =
  "A community-led Budapest meetup where developers share ideas, get practical guidance, and move their apps forward during Shipaton 2026.";
---

<BaseLayout title={pageTitle} description={description}>
  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__copy">
        <p class="eyebrow"><span aria-hidden="true"></span> Budapest · Shipaton 2026</p>
        <h1 id="hero-title">Move your app forward in good company.</h1>
        <p class="hero__lede">
          A welcoming Budapest meetup to share ideas, get practical guidance, and make progress on the app you want to ship.
        </p>
        <div class="hero__actions">
          <ButtonLink href="#events" variant="primary">
            See the event schedule <span aria-hidden="true">↓</span>
          </ButtonLink>
          <ButtonLink
            href="https://revenuecat-shipaton-2026.devpost.com/"
            rel="noreferrer"
          >Join Shipaton 2026 <span aria-hidden="true">↗</span></ButtonLink>
        </div>
      </div>
      <a
        class="hero__art-link"
        href={featuredEventUrl}
        aria-label={`View ${featuredEvent.data.title} event details`}
        data-featured-event
      >
        <figure class="hero__art">
          <img
            src="/2026/brand/rocket-launch-wide.svg"
            width="1000"
            height="498"
            alt="Shippy the cat launching in an orange rocket"
            decoding="async"
            fetchpriority="high"
          />
          <figcaption>
            <span data-featured-title>{featuredEvent.data.title}</span>
            <strong data-featured-location>{featuredEvent.data.heroVenue ?? featuredEvent.data.venue}</strong>
          </figcaption>
        </figure>
      </a>
    </section>

    <section class="events" id="events" aria-labelledby="events-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow eyebrow--light"><span aria-hidden="true"></span> The Budapest series</p>
          <h2 id="events-title">Progress starts here.</h2>
        </div>
        <p>
          Follow the latest Budapest event updates and help shape what comes next.
        </p>
      </div>

      <div class="event-browser" data-event-browser>
        <div class="event-controls" data-event-controls aria-label="Event navigation" hidden>
          <button type="button" data-event-direction="-1" aria-label="Show previous event">
            <span aria-hidden="true">←</span>
          </button>
          <output data-event-counter aria-live="polite">1 / {events.length + 1}</output>
          <button type="button" data-event-direction="1" aria-label="Show next event">
            <span aria-hidden="true">→</span>
          </button>
        </div>

        <ol class="event-track" data-event-track aria-label="Shipaton Budapest event lineup">
          {events.map(({ id, data: event }) => (
            <li
              class="event-card"
              id={id}
              data-event-rail-card
              data-event-card
              data-event-url={eventPath(id)}
              data-date={event.date}
              data-status={event.status}
              data-title={event.title}
              data-venue={event.venue}
              data-hero-venue={event.heroVenue ?? event.venue}
            >
              <div class="event-card__topline">
                <span class="event-card__sequence">Orbit {event.sequence}</span>
                <span class="event-card__state" data-event-state>{formatEventStatus(event.status)}</span>
              </div>
              {event.status === "scheduled"
                ? <time datetime={event.date}>{formatEventDateLabel(event.date, event.status)}</time>
                : <span class="event-card__date-label">{formatEventDateLabel(event.date, event.status)}</span>}
              <h3>{event.title}</h3>
              <p class="event-card__format">{event.format}</p>
              <p class="event-card__description">{event.description}</p>
              <dl>
                <div>
                  <dt>When</dt>
                  <dd>{event.time}</dd>
                </div>
                <div>
                  <dt>Where</dt>
                  <dd>{event.venue}</dd>
                </div>
                {event.hosts && <PersonList kind="hosts" people={event.hosts} />}
                {event.organizers && <PersonList kind="organizers" people={event.organizers} />}
                {event.speakers && (
                  <PersonList class="event-card__speakers" kind="speakers" people={event.speakers.slice(0, 3)} />
                )}
              </dl>
              <a class="event-card__soon" href={eventPath(id)}>View event details →</a>
            </li>
          ))}
          <li
            class="event-card"
            data-event-rail-card
            data-event-teaser
            data-visible-before={competitionDeadline}
            hidden
          >
            <div class="event-card__topline">
              <span class="event-card__sequence">Your turn</span>
              <span class="event-card__state">Ideas welcome</span>
            </div>
            <span class="event-card__teaser-kicker">Not organized yet</span>
            <h3>What should happen next?</h3>
            <p class="event-card__format">Potential Shipaton Budapest event</p>
            <p class="event-card__description">
              Share your Shipaton Budapest experience—or tell the organizer what you would like to see at an upcoming event.
            </p>
            <dl>
              <div>
                <dt>Status</dt>
                <dd>Waiting for your ideas</dd>
              </div>
              <div>
                <dt>Contact the organizer</dt>
                <dd class="event-card__contacts">
                  <a href="https://x.com/hlcaptain" target="_blank" rel="noopener noreferrer">
                    X <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span>
                  </a>
                  <a
                    href="https://www.linkedin.com/in/balazs-puspok-kiss"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    LinkedIn <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span>
                  </a>
                </dd>
              </div>
            </dl>
          </li>
        </ol>
      </div>

      <p class="schedule-note">
        <span aria-hidden="true">✦</span> Registration is open for the confirmed Project Kickoff.
      </p>
    </section>

    <section class="principles" aria-labelledby="principles-title">
      <div>
        <p class="eyebrow"><span aria-hidden="true"></span> Flexible schedule, practical focus</p>
        <h2 id="principles-title">Learn together.<br />Build your way.</h2>
      </div>
      <ol>
        <li>
          <span>01</span>
          <h3>Start where you are</h3>
          <p>Join a lightning talk, keep building, or ask a question. Use the day in the way that moves your app forward.</p>
        </li>
        <li>
          <span>02</span>
          <h3>Build with support</h3>
          <p>Collaborate with other attendees, trade feedback, or ask a mentor for a fresh perspective when you get stuck.</p>
        </li>
        <li>
          <span>03</span>
          <h3>Leave with a next step</h3>
          <p>Progress can be a working feature, a solved blocker, or clarity about what you want to try after the meetup.</p>
        </li>
      </ol>
    </section>
  </main>

  <script is:inline src="/2026/scripts/event-rail.js" defer></script>
</BaseLayout>
