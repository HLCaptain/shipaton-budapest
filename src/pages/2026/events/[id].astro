---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import ButtonLink from "../../../editions/2026/components/ButtonLink.astro";
import PersonList from "../../../editions/2026/components/PersonList.astro";
import SectionHeading from "../../../editions/2026/components/SectionHeading.astro";
import BaseLayout from "../../../editions/2026/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  return (await getCollection("events2026")).map((event) => ({
    params: { id: event.id },
    props: { event }
  }));
}

type Props = {
  event: CollectionEntry<"events2026">;
};

const { event } = Astro.props;
const { Content, headings } = await render(event);
const hosts = event.data.hosts ?? [];
const organizers = event.data.organizers ?? [];
const speakers = event.data.speakers ?? [];
const hasPeople = hosts.length + organizers.length + speakers.length > 0;
const contentHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
const thumbnail = event.data.thumbnail;
const date = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "Europe/Budapest"
}).format(new Date(`${event.data.date}T12:00:00Z`));
---

<BaseLayout title={`${event.data.title} · Shipaton Budapest`} description={event.data.description}>
  <main class="event-document" id="main-content">
    <button class="button button--quiet button--compact event-document__back" type="button" data-history-back>
      <svg class="button__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M13 8H3m0 0 4-4M3 8l4 4" />
      </svg>
      Back
    </button>

    <header class="event-document__header">
      <div class:list={["event-document__hero", { "event-document__hero--with-thumbnail": Boolean(thumbnail) }]}>
        <div class="event-document__hero-copy">
          <p class="eyebrow"><span aria-hidden="true"></span> Orbit {event.data.sequence} · {date}</p>
          <h1>{event.data.title}</h1>
          <p>{event.data.description}</p>
        </div>
        {thumbnail && (
          <img
            class="event-document__thumbnail"
            src={thumbnail.src}
            alt={thumbnail.alt}
            width={thumbnail.width}
            height={thumbnail.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        )}
      </div>
      <dl class="event-document__facts">
        <div>
          <dt>Date</dt>
          <dd><time datetime={event.data.date}>{date}</time></dd>
        </div>
        <div>
          <dt>Time</dt>
          <dd>{event.data.time}</dd>
        </div>
        <div>
          <dt>Location</dt>
          <dd>
            {event.data.locationUrl
              ? <a href={event.data.locationUrl} rel="noreferrer">{event.data.venue} <span aria-hidden="true">↗</span></a>
              : event.data.venue}
          </dd>
        </div>
        <div>
          <dt>Themes</dt>
          <dd>{event.data.themes.join(" · ")}</dd>
        </div>
        <div>
          <dt>RSVP</dt>
          <dd>
            {event.data.rsvp
              ? <a href={event.data.rsvp} rel="noreferrer">Reserve a place <span aria-hidden="true">↗</span></a>
              : <span>Local registration opens soon · <a href="https://www.shipaton.com/events" rel="noreferrer">official listing <span aria-hidden="true">↗</span></a></span>}
          </dd>
        </div>
      </dl>
      <ul class="tag-list event-document__tags" aria-label="Event tags">
        {event.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
      {(event.data.rsvp || event.data.presentation || event.data.attachment) && (
        <nav class="event-document__resources" aria-label="Event resources">
          {event.data.rsvp && (
            <ButtonLink href={event.data.rsvp} rel="noreferrer" variant="primary">
              RSVP <span aria-hidden="true">↗</span>
            </ButtonLink>
          )}
          {event.data.presentation && <ButtonLink href={event.data.presentation}>Open presentation <span aria-hidden="true">↗</span></ButtonLink>}
          {event.data.attachment && <ButtonLink href={event.data.attachment}>Open attachment <span aria-hidden="true">↗</span></ButtonLink>}
        </nav>
      )}
    </header>

    <section class="event-schedule" aria-labelledby="schedule-title">
      <SectionHeading eyebrow="Run of show" id="schedule-title" title="Schedule" />
      <ol role="list">
        {event.data.schedule.map((item) => (
          <li>
            <span class="event-schedule__time">{item.time}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {hasPeople && (
      <section class="event-people" aria-labelledby="people-title">
        <SectionHeading eyebrow="Meet the people" id="people-title" title="Event team" />
        <dl class="event-people__groups">
          {hosts.length > 0 && <PersonList kind="hosts" people={hosts} showRoles />}
          {organizers.length > 0 && <PersonList kind="organizers" people={organizers} showRoles />}
          {speakers.length > 0 && <PersonList kind="speakers" people={speakers} showRoles />}
        </dl>
      </section>
    )}

    <section class="event-about" aria-labelledby="about-title">
      <div class="event-about__heading">
        <SectionHeading eyebrow="Know before you go" id="about-title" title="About this event" />
      </div>
      <div class="event-about__layout">
        {contentHeadings.length > 0 && (
          <nav class="event-document__toc" aria-label="On this page">
            <p>On this page</p>
            <ol>
              {contentHeadings.map((heading) => (
                <li data-depth={heading.depth}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}
        <article class="event-document__body">
          <Content />
        </article>
      </div>
      <p class="visually-hidden" role="status" aria-live="polite" data-heading-copy-status></p>
    </section>

    <ButtonLink class="button--compact event-document__end-link" href="/2026/events/">
      <svg class="button__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M13 8H3m0 0 4-4M3 8l4 4" />
      </svg>
      Back to 2026 events
    </ButtonLink>
  </main>

  <script is:inline src="/2026/scripts/event-document.js" defer></script>
</BaseLayout>
