---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const events = (await getCollection("events")).sort((a, b) => a.data.date.localeCompare(b.data.date));
const dateFormatter = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "Europe/Budapest"
});
---

<BaseLayout
  title="Events · Shipaton Budapest"
  description="Browse the Shipaton Budapest meetup schedule and open each event for its details, agenda, and attendance information."
>
  <main class="events-page" id="main-content">
    <header class="events-page__intro">
      <p class="eyebrow"><span aria-hidden="true"></span> Budapest event calendar</p>
      <h1>Meet. Make.<br />Ship together.</h1>
      <p>
        Pick the session that matches where your app is now. Each event page has the agenda, practical details, and what to bring.
      </p>
    </header>

    <ol class="event-grid" aria-label="Shipaton Budapest events">
      {events.map(({ id, data: event }) => (
        <li>
          <a class="event-grid-card" href={`/events/${id}/`}>
            <div class="event-grid-card__topline">
              <span>Orbit {event.sequence}</span>
              <time datetime={event.date}>{dateFormatter.format(new Date(`${event.date}T12:00:00Z`))}</time>
            </div>
            <h2>{event.title}</h2>
            <p class="event-grid-card__format">{event.format}</p>
            <p>{event.description}</p>
            <dl>
              <div>
                <dt>When</dt>
                <dd>{event.time}</dd>
              </div>
              <div>
                <dt>Where</dt>
                <dd>{event.venue}</dd>
              </div>
            </dl>
            <ul class="tag-list" aria-label="Event tags">
              {event.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <span class="event-grid-card__cta">Event details <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ol>
  </main>
</BaseLayout>
