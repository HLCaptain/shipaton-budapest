---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { edition } from "../config";
import { getEvents2026 } from "../content";
import { resolveProfile } from "../resolve";
import NoticeBanner from "../components/NoticeBanner.astro";
import { eventPath } from "../events";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(edition.assets.socialImage, Astro.site);
const socialImageAlt = `${edition.name} ${edition.year} with Shippy launching in an orange rocket`;
const eventsCurrent = Astro.url.pathname.startsWith(edition.eventsPath);
const events = await getEvents2026();
const contact = resolveProfile({ ref: edition.contactProfile }, "edition.contactProfile");
const footerEvents = edition.footerEventIds.map((id) => {
  const event = events.find(({ entry }) => entry.id === id);
  if (!event) throw new Error(`edition.footerEventIds: unknown event reference "${id}"`);
  return event;
});
const sitewideNotices = events
  .filter(({ data }) => data.notice?.sitewide)
  .slice(0, 1)
  .filter((event) => Astro.url.pathname !== eventPath(event.entry.id));
---

<!doctype html>
<html lang="en" data-edition={edition.year}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4efe5" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={edition.assets.icon} type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <script is:inline src="/2026/scripts/page-transitions.js"></script>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={edition.homePath} aria-label={`${edition.name} home`}>
        <img
          src={edition.assets.wordmark}
          width="535"
          height="128"
          alt={edition.competitionName}
          decoding="async"
        />
        <span>{edition.city}</span>
      </a>
      <nav class="site-header__nav" aria-label="Primary navigation">
        <a href={edition.eventsPath} aria-current={eventsCurrent ? "page" : undefined}>Events</a>
        <a href={edition.links.official} rel="noreferrer">Official Shipaton <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    {sitewideNotices.map((event) => (
      <NoticeBanner
        href={eventPath(event.entry.id)}
        label={event.data.notice!.label}
        linkLabel={`View ${event.data.title} update`}
        message={event.data.notice!.message}
        variant="sitewide"
      />
    ))}
    <div class="page-transition">
      <slot />
    </div>
    <footer class="site-footer">
      <div class="site-footer__grid">
        <section class="site-footer__brand" aria-labelledby="footer-brand-title">
          <p class="site-footer__kicker">{edition.name} · {edition.year}</p>
          <h2 id="footer-brand-title">A local community.<br />Real momentum.</h2>
          <p>Meet local developers, trade ideas, and move your app one useful step forward.</p>
        </section>

        <nav class="site-footer__column" aria-labelledby="footer-explore-title">
          <h2 id="footer-explore-title">Explore</h2>
          <a href={edition.homePath}>Home</a>
          <a href={edition.eventsPath}>All events</a>
          {footerEvents.map(({ entry, data }) => <a href={eventPath(entry.id)}>{data.title}</a>)}
          <a
            href={edition.links.repository}
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub repository <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </nav>

        <nav class="site-footer__column" aria-labelledby="footer-shipaton-title">
          <h2 id="footer-shipaton-title">Shipaton</h2>
          <a href={edition.links.official} rel="noreferrer">Official site <span aria-hidden="true">↗</span></a>
          <a href={edition.links.events} rel="noreferrer">IRL events <span aria-hidden="true">↗</span></a>
          <a href={edition.links.competition} rel="noreferrer">Join on Devpost <span aria-hidden="true">↗</span></a>
          <a href={edition.links.mediaKit} rel="noreferrer">Media kit <span aria-hidden="true">↗</span></a>
        </nav>

        <section class="site-footer__column" aria-labelledby="footer-contact-title">
          <h2 id="footer-contact-title">Contact</h2>
          <div class="site-footer__socials">
            {contact.social?.github && <a class="social-link" href={contact.social.github} rel="noreferrer" aria-label="GitHub" title="GitHub">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 .7a11.3 11.3 0 0 0-3.6 22c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6A11.3 11.3 0 0 0 12 .7Z" />
              </svg>
            </a>}
            {contact.social?.x && <a class="social-link" href={contact.social.x} rel="noreferrer" aria-label="X" title="X">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M18.2 2.3h3.3l-7.2 8.2 8.5 11.2h-6.7l-5.2-6.8-6 6.8H1.7l7.7-8.8L1.3 2.3h6.8l4.7 6.2 5.4-6.2Zm-1.1 17.5h1.8L7.1 4.1h-2l12 15.7Z" />
              </svg>
            </a>}
          </div>
        </section>
      </div>

      <div class="site-footer__bottom">
        <p>Community-led in {edition.city} · {edition.competitionName}</p>
      </div>
    </footer>
  </body>
</html>
