---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const eventsCurrent = Astro.url.pathname.startsWith("/2026/events");
---

<!doctype html>
<html lang="en" data-edition="2026">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4efe5" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/2026/brand/shippy-pixel-head.png" type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/2026/" aria-label="Shipaton Budapest home">
        <img
          src="/2026/brand/shipaton-wordmark.svg"
          width="535"
          height="128"
          alt="Shipaton 2026"
          decoding="async"
        />
        <span>Budapest</span>
      </a>
      <nav class="site-header__nav" aria-label="Primary navigation">
        <a href="/2026/events/" aria-current={eventsCurrent ? "page" : undefined}>Events</a>
        <a href="https://www.shipaton.com/" rel="noreferrer">Official Shipaton <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <div class="page-transition">
      <slot />
    </div>
    <footer class="site-footer">
      <div class="site-footer__grid">
        <section class="site-footer__brand" aria-labelledby="footer-brand-title">
          <p class="site-footer__kicker">Shipaton Budapest · 2026</p>
          <h2 id="footer-brand-title">Build locally.<br />Ship globally.</h2>
          <p>Meet local builders, find momentum, and turn a small idea into an app people can actually use.</p>
        </section>

        <nav class="site-footer__column" aria-labelledby="footer-explore-title">
          <h2 id="footer-explore-title">Explore</h2>
          <a href="/2026/">Home</a>
          <a href="/2026/events/">All events</a>
          <a href="/2026/events/project-kickoff/">Project Kickoff</a>
          <a
            href="https://github.com/HLCaptain/shipaton-budapest"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub repository <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </nav>

        <nav class="site-footer__column" aria-labelledby="footer-shipaton-title">
          <h2 id="footer-shipaton-title">Shipaton</h2>
          <a href="https://www.shipaton.com/" rel="noreferrer">Official site <span aria-hidden="true">↗</span></a>
          <a href="https://www.shipaton.com/events" rel="noreferrer">IRL events <span aria-hidden="true">↗</span></a>
          <a href="https://revenuecat-shipaton-2026.devpost.com/" rel="noreferrer">Join on Devpost <span aria-hidden="true">↗</span></a>
          <a href="https://www.shipaton.com/media-kit" rel="noreferrer">Media kit <span aria-hidden="true">↗</span></a>
        </nav>

        <section class="site-footer__column" aria-labelledby="footer-contact-title">
          <h2 id="footer-contact-title">Contact</h2>
          <div class="site-footer__socials">
            <a class="social-link" href="https://github.com/HLCaptain" rel="noreferrer" aria-label="GitHub" title="GitHub">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 .7a11.3 11.3 0 0 0-3.6 22c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6A11.3 11.3 0 0 0 12 .7Z" />
              </svg>
            </a>
            <a class="social-link" href="https://x.com/hlcaptain" rel="noreferrer" aria-label="X" title="X">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M18.2 2.3h3.3l-7.2 8.2 8.5 11.2h-6.7l-5.2-6.8-6 6.8H1.7l7.7-8.8L1.3 2.3h6.8l4.7 6.2 5.4-6.2Zm-1.1 17.5h1.8L7.1 4.1h-2l12 15.7Z" />
              </svg>
            </a>
          </div>
        </section>
      </div>

      <div class="site-footer__bottom">
        <p>Community-led in Budapest · August—September 2026</p>
      </div>
    </footer>
    <script is:inline src="/2026/scripts/page-transitions.js" defer></script>
  </body>
</html>
