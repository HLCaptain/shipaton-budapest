---
type Props = {
  href?: string;
  label?: string;
  linkLabel?: string;
  message: string;
  variant?: "embedded" | "sitewide";
};

const {
  href,
  label = "Important update",
  linkLabel = "View event update",
  message,
  variant = "embedded"
} = Astro.props;
---

<aside
  class:list={[
    "notice-banner",
    `notice-banner--${variant}`
  ]}
  aria-label={label}
  data-notice-banner
  data-variant={variant}
>
  <div class="notice-banner__inner">
    {variant === "embedded" && (
      <span class="notice-banner__marker" aria-hidden="true">!</span>
    )}
    <span class="notice-banner__copy">
      {variant === "embedded" && <strong class="notice-banner__label">{label}</strong>}
      <span class="notice-banner__message">{message}</span>
    </span>
    {href && (
      <a
        class="notice-banner__link"
        href={href}
        aria-label={linkLabel}
        title={linkLabel}
      >
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M2.5 8h10m-4-4 4 4-4 4" />
        </svg>
      </a>
    )}
  </div>
</aside>
