---
import type { ResolvedEvent } from "../content";
import { edition } from "../config";
import {
  eventPath,
  formatEventDateLabel,
  formatEventStatus
} from "../events";
import PersonList from "./PersonList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

type Props = {
  events: ResolvedEvent[];
};

const { events } = Astro.props;
---

<BaseLayout
  title={`Events · ${edition.name}`}
  description={`Browse ${edition.year} ${edition.name} events and open each session for its details, agenda, and attendance information.`}
>
  <main class="events-page" id="main-content">
    <header class="events-page__intro">
      <p class="eyebrow"><span aria-hidden="true"></span> {edition.city} {edition.year} events</p>
      <h1>Meet. Make.<br />Ship together.</h1>
      <p class="events-page__lede">
        Open an event for its full agenda, practical details, and what to bring.
      </p>
    </header>

    <ol class="event-grid" aria-label={`${edition.year} ${edition.name} events`}>
      {events.map((event) => (
        <li>
          <article class="event-grid-card" data-event-status={event.data.status}>
            <div class="event-grid-card__topline">
              <span>Orbit {event.data.sequence}</span>
              <span>
                {formatEventStatus(event.data.status)} · {
                  event.data.status === "scheduled"
                    ? <time datetime={event.data.date}>{formatEventDateLabel(event.data.date, event.data.status)}</time>
                    : formatEventDateLabel(event.data.date, event.data.status)
                }
              </span>
            </div>
            <h2><a class="event-grid-card__link" href={eventPath(event.entry.id)}>{event.data.title}</a></h2>
            <p class="event-grid-card__format">{event.data.format}</p>
            <p>{event.data.description}</p>
            <dl>
              <div>
                <dt>When</dt>
                <dd>{event.data.time}</dd>
              </div>
              <div>
                <dt>Where</dt>
                <dd>{event.data.venue.label}</dd>
              </div>
              {event.data.hosts.length > 0 && <PersonList kind="hosts" people={event.data.hosts} />}
              {event.data.organizers.length > 0 && <PersonList kind="organizers" people={event.data.organizers} />}
              {event.data.speakers.length > 0 && (
                <PersonList class="event-grid-card__speakers" kind="speakers" people={event.data.speakers.slice(0, 3)} />
              )}
            </dl>
            <ul class="tag-list" aria-label="Event tags">
              {event.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <span class="event-grid-card__cta">Event details <span aria-hidden="true">→</span></span>
          </article>
        </li>
      ))}
    </ol>
  </main>
</BaseLayout>
